import sqlite3
def connect():
    return sqlite3.connect("data.db")

create_beans_table = "CREATE TABLE IF NOT EXISTS beans (id INTEGER PRIMARY KEY, name TEXT, method TEXT, rating INTEGER);"

insert_bean = "INSERT INTO beans (name, method, rating) VALUES (?, ?, ?);"

delete_bean_by_name1 = "DELETE FROM beans WHERE name = ?;"
get_all_beans1 = "SELECT * FROM beans;"
get_beans_by_name1 = "SELECT * FROM beans WHERE name = ?;"
get_best_preparation_for_bean1 = """
SELECT * FROM beans
WHERE name = ?
ORDER BY rating DESC
LIMIT 1;"""


def create_tables(connection):
    with connection:
        connection.execute(create_beans_table)

def add_bean(connection, name, method, rating):
    with connection:
        connection.execute(insert_bean, (name, method, rating))

def get_all_beans(connection):
    with connection:
        return connection.execute(get_all_beans1).fetchall()

def get_beans_by_name(connection, name):
    with connection:
        return connection.execute(get_beans_by_name1, (name,)).fetchall()

def get_best_preparation_for_bean(connection, name):
    with connection:
        return connection.execute(get_best_preparation_for_bean1, (name,)).fetchone()

def delete_bean_by_name(connection, name):
    with connection:
        connection.execute(delete_bean_by_name1, (name, ))
