import sqlite3
def connect():
    return sqlite3.connect("data.db")

create_games_table = "CREATE TABLE IF NOT EXISTS games (id INTEGER PRIMARY KEY, name TEXT, genre TEXT, rating INTEGER);"

insert_game = "INSERT INTO games (name, genre, rating) VALUES (?, ?, ?);"

delete_game_by_name1 = "DELETE FROM games WHERE name = ?;"
delete_game_by_id1 = "DELETE FROM games WHERE id = ?;"
get_all_games1 = "SELECT * FROM games;"
get_games_by_name1 = "SELECT * FROM games WHERE name = ?;"
get_games_by_id1 = "SELECT * FROM games WHERE id = ?;"
get_best_genre_for_game1 = """
SELECT * FROM games
WHERE name = ?
ORDER BY rating DESC
LIMIT 1;"""
get_games_by_rating_range1 = """
SELECT * FROM games
WHERE rating BETWEEN ? AND ?
ORDER BY rating DESC"""

def create_tables(connection):
    with connection:
        connection.execute(create_games_table)

def add_game(connection, name, genre, rating):
    with connection:
        connection.execute(insert_game, (name, genre, rating))

def get_all_games(connection):
    with connection:
        return connection.execute(get_all_games1).fetchall()

def get_games_by_name(connection, name):
    with connection:
        return connection.execute(get_games_by_name1, (name,)).fetchall()

def get_games_by_id(connection, id):
    with connection:
        return connection.execute(get_games_by_id1, (id,)).fetchall()

def get_best_genre_for_game(connection, name):
    with connection:
        return connection.execute(get_best_genre_for_game1, (name,)).fetchone()

def delete_game_by_name(connection, name):
    with connection:
        connection.execute(delete_game_by_name1, (name, ))

def delete_game_by_id(connection, id):
    with connection:
        connection.execute(delete_game_by_id1, (id, ))

def get_games_by_rating_range(connection, min_range, max_range):
    with connection:
        return connection.execute(get_games_by_rating_range1, (min_range, max_range)).fetchall()
